# Required: powers the guide-generation agent (server-side only, never exposed to
# the client). Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: overrides the model that reads documentation and labels evidence.
# Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# Optional: overrides the model that lists candidate documentation URLs.
# Defaults to openai/gpt-oss-20b.
GROQ_DISCOVERY_MODEL=

# Optional: lets the agent read composio_managed_auth_schemes directly from the
# Composio API. Without it the agent falls back to the public toolkit docs page
# and labels the result "sourced" rather than confirmed.
COMPOSIO_API_KEY=

# Optional: persists generated guides so /guides/<slug> URLs are shareable.
# Provisioned automatically by the Upstash Redis integration in the Vercel
# dashboard (Storage -> Create Database), which sets these names for you.
# Without them, generated guides fall back to a local .data file, which works in
# dev but NOT on Vercel's read-only filesystem.
KV_REST_API_URL=
KV_REST_API_TOKEN=
